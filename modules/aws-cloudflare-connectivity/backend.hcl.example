# Copy to backend.hcl (gitignored) for local use, or supply these as
# TF_STATE_* repo variables for CI (see .github/workflows).
bucket         = "REPLACE_ME-tfstate-clickhouse-infra"
key            = "modules/aws-cloudflare-connectivity/terraform.tfstate"
region         = "eu-north-1"
dynamodb_table = "REPLACE_ME-tfstate-lock-clickhouse-infra"
encrypt        = true
